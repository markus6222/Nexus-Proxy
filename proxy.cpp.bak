std::string extractData(const std::string& label, const std::string& webData) {
    size_t labelPos = webData.find(label);
    if (labelPos != std::string::npos) {
        size_t start = labelPos + label.length();
        size_t end = webData.find(" ", start);
        return webData.substr(start, end - start);
    }
    else {
        return "Etiket bulunamadi.";
    }
}

