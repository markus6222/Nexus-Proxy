BOOL WINAPI ConsoleHandler(DWORD dwType)
{
    switch (dwType) {
    case CTRL_LOGOFF_EVENT: case CTRL_SHUTDOWN_EVENT: case CTRL_CLOSE_EVENT:
    {
        reset_host();
        return TRUE;
    }
    default:
    {
        break;
    }
    }
    return FALSE;
}
